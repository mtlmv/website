DB_HOST=localhost
DB_PORT=5432
DB_NAME=website
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# Дополнительные параметры JDBC. Локально не нужны.
# Для облачных баз с обязательным SSL (например Neon): ?sslmode=require
DB_PARAMS=

# Минимум 32 байта. Сгенерировать новый:
#   head -c 48 /dev/urandom | base64
JWT_SECRET=CHANGE_ME_GENERATE_YOUR_OWN_SECRET_AT_LEAST_32_BYTES_LONG
JWT_EXPIRATION_MS=86400000
